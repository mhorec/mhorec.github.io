---
// src/layouts/Base.astro
import '../styles/global.css';
import { site } from '../data/site';
import { getAltPath, type Lang } from '../i18n';
import SeoJsonLd from '../components/SeoJsonLd.astro';
import Header from '../components/Header.astro';

interface Props { lang: Lang; title: string; description: string; path: string; }
const { lang, title, description, path } = Astro.props;

// `site.origin` includes the Pages base path (this repo is served from a
// subdirectory, not a root domain). `new URL('/', origin)` would resolve the
// leading slash against the DOMAIN root and silently drop that base — which
// shipped canonicals pointing at the wrong site. Concatenate instead.
const abs = (p: string) => site.origin.replace(/\/$/, '') + p;

const canonical = abs(path);
const enHref = abs(getAltPath(path, 'en'));
const idHref = abs(getAltPath(path, 'id'));
const ogImage = abs('/social-card.png');
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <link rel="alternate" hreflang="en" href={enHref} />
    <link rel="alternate" hreflang="id" href={idHref} />
    <link rel="alternate" hreflang="x-default" href={enHref} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.legalName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <!-- Dimensions let WhatsApp/LinkedIn reserve the right box before the image
         loads, so the preview does not reflow; alt text is read by screen
         readers on platforms that surface it. -->
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:alt" content={`${site.legalName} — ${description}`} />
    <meta property="og:locale" content={lang === 'id' ? 'id_ID' : 'en_US'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={`${site.legalName} — ${description}`} />

    <link rel="icon" href="/icon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#0880E0" />

    <SeoJsonLd lang={lang} />
  </head>
  <body>
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded focus:bg-white focus:px-4 focus:py-2">
      {lang === 'id' ? 'Lompat ke konten' : 'Skip to content'}
    </a>
    <Header lang={lang} path={path} />
    <slot />
  </body>
</html>
