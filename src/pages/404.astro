---
import Base from '../layouts/Base.astro';
---
<Base lang="en" title="Page not found - MHCreation" description="That page does not exist." path="/404">
  <main id="main" class="mx-auto flex max-w-3xl flex-col items-center px-4 py-28 text-center">
    <p class="text-6xl font-extrabold tracking-tight text-brand-blue-ink">404</p>
    <h1 class="mt-4 text-2xl font-bold tracking-tight text-ink">We cannot find that page</h1>
    <p class="mt-3 text-muted">It may have moved, or the link may be out of date.</p>
    <a href="/" class="mt-8 rounded-lg bg-brand-blue-ink px-6 py-3 text-sm font-semibold text-white">
      Back to home
    </a>
  </main>
</Base>
