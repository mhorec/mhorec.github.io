---
import { serviceKeys } from '../data/services';
import { useTranslations, type Lang } from '../i18n';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = useTranslations(lang);
---
<section id="services" class="mx-auto max-w-6xl px-4 py-12 md:py-16">
  <h2 class="font-display text-4xl font-extrabold tracking-[-0.03em] text-ink md:text-5xl">{t('services.title')}</h2>
  <p class="mt-2 text-muted">{t('services.lead')}</p>
  <ul class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
    {serviceKeys.map(k => (
      <li class="rounded-xl border border-line p-6 transition hover:border-brand-blue">
        <span class="mb-4 block h-1.5 w-10 rounded-full bg-brand-green"></span>
        <h3 class="text-base font-semibold text-ink">{t(`services.items.${k}.t`)}</h3>
        <p class="mt-2 text-sm leading-relaxed text-muted">{t(`services.items.${k}.d`)}</p>
      </li>
    ))}
  </ul>
</section>
