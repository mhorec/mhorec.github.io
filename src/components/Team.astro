---
import { team } from '../data/team';
import Avatar from './Avatar.astro';
import { useTranslations, type Lang } from '../i18n';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = useTranslations(lang);
---
<section id="team" class="mx-auto max-w-6xl px-4 py-12 md:py-16">
  <h2 class="font-display text-4xl font-extrabold tracking-[-0.03em] text-ink md:text-5xl">{t('team.title')}</h2>
  <p class="mt-2 text-muted">{t('team.lead')}</p>
  <ul class="mt-6 grid gap-6 sm:grid-cols-3">
    {team.map(m => (
      <li class="rounded-xl border border-line p-6 text-center">
        <div class="mx-auto mb-3 w-fit"><Avatar initials={m.initials} /></div>
        <h3 class="text-sm font-semibold text-ink">{m.name}</h3>
        <p class="text-xs text-muted">{t(`team.roles.${m.roleKey}`)}</p>
        <div class="mt-3 flex justify-center gap-3 text-xs font-semibold text-brand-blue-ink">
          {m.links.linkedin && <a href={m.links.linkedin} target="_blank" rel="noopener">LinkedIn</a>}
          {m.links.github && <a href={m.links.github} target="_blank" rel="noopener">GitHub</a>}
        </div>
      </li>
    ))}
  </ul>
</section>
