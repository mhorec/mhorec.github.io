---
import { site } from '../data/site';
import Logo from './Logo.astro';
import { useTranslations, type Lang } from '../i18n';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = useTranslations(lang);
const prefix = lang === 'id' ? '/id' : '';
const year = new Date().getFullYear();
---
<footer class="border-t border-line bg-white">
  <div class="mx-auto grid max-w-6xl gap-8 px-4 py-12 sm:grid-cols-[1.5fr_1fr_1fr]">
    <div>
      <div class="flex items-center gap-2 font-display text-lg font-extrabold tracking-[-0.02em]"><Logo size={28} /><span>MHCreation</span></div>
      <p class="mt-3 max-w-xs text-sm leading-relaxed text-muted">{t('hero.lead')}</p>
    </div>
    <nav aria-label="Footer">
      <h2 class="text-xs font-semibold uppercase tracking-wider text-ink">{t('nav.services')}</h2>
      <ul class="mt-3 space-y-2 text-sm text-muted">
        <li><a class="hover:text-brand-blue-ink" href={`${prefix}/#services`}>{t('nav.services')}</a></li>
        <li><a class="hover:text-brand-blue-ink" href={`${prefix}/#work`}>{t('nav.work')}</a></li>
        <li><a class="hover:text-brand-blue-ink" href={`${prefix}/#team`}>{t('nav.team')}</a></li>
        <li><a class="hover:text-brand-blue-ink" href={`${prefix}/#contact`}>{t('nav.contact')}</a></li>
      </ul>
    </nav>
    <div>
      <h2 class="text-xs font-semibold uppercase tracking-wider text-ink">{t('nav.contact')}</h2>
      <address class="mt-3 space-y-1 not-italic text-sm text-muted">
        <p>{site.address.city}, {site.address.region}</p>
        <p><a class="hover:text-brand-blue-ink" href={`mailto:${site.email}`}>{site.email}</a></p>
        <p><a class="hover:text-brand-blue-ink" href={site.whatsappUrl} target="_blank" rel="noopener">{site.phone}</a></p>
      </address>
    </div>
  </div>
  <div class="border-t border-line">
    <p class="mx-auto max-w-6xl px-4 py-5 text-xs text-muted">
      &copy; {year} {site.legalName}. {t('footer.rights')}
    </p>
  </div>
</footer>
