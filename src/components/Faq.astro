---
import { useTranslations, type Lang } from '../i18n';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = useTranslations(lang);
const ids = ['stack', 'timeline', 'maintenance', 'government', 'pricing', 'remote'];
---
<section id="faq" class="border-t border-line bg-tint">
  <div class="mx-auto max-w-3xl px-4 py-12 md:py-16">
    <h2 class="font-display text-4xl font-extrabold tracking-[-0.03em] text-ink md:text-5xl">{t('faq.title')}</h2>
    <div class="mt-6 divide-y divide-line rounded-xl border border-line bg-white">
      {ids.map(id => (
        <details class="group p-5">
          <summary class="cursor-pointer list-none text-sm font-semibold text-ink">
            {t(`faq.items.${id}.q`)}
          </summary>
          <p class="mt-3 text-sm leading-relaxed text-muted">{t(`faq.items.${id}.a`)}</p>
        </details>
      ))}
    </div>
  </div>
</section>
