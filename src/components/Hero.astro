---
import { site } from '../data/site';
import { useTranslations, type Lang } from '../i18n';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = useTranslations(lang);
const prefix = lang === 'id' ? '/id' : '';
---
<section class="mx-auto grid max-w-6xl items-center gap-10 px-4 py-10 md:grid-cols-[1.25fr_1fr] md:py-14">
  <div>
    <p class="mb-4 inline-block rounded bg-tint px-3 py-1.5 text-xs font-semibold uppercase tracking-wider text-brand-green-ink">
      {t('hero.eyebrow')}
    </p>
    <h1 class="font-display text-5xl font-extrabold leading-[1.02] tracking-[-0.03em] text-ink md:text-7xl">
      {t('hero.title')}
    </h1>
    <p class="mt-5 max-w-xl text-base leading-relaxed text-muted">{t('hero.lead')}</p>
    <div class="mt-8 flex flex-wrap gap-3">
      <a href={site.whatsappUrl} target="_blank" rel="noopener"
         class="rounded-lg bg-brand-blue-ink px-6 py-3 text-sm font-semibold text-white hover:brightness-110">
        {t('hero.ctaPrimary')}
      </a>
      <a href={`${prefix}/#work`}
         class="rounded-lg border border-line px-6 py-3 text-sm font-semibold text-ink hover:border-brand-blue">
        {t('hero.ctaSecondary')}
      </a>
    </div>
  </div>

  <div class="hidden justify-center md:flex" aria-hidden="true">
    <div class="scene">
      <div class="cube">
        <span class="face"></span><span class="face"></span><span class="face"></span><span class="face"></span>
      </div>
      <!-- Sibling of .cube, not a child: inside the cube it rotates and renders mirrored. -->
      <span class="mark">MH</span>
    </div>
  </div>
</section>

<style>
  .scene { perspective: 1000px; position: relative; width: 150px; height: 150px; }
  .cube { position: relative; width: 150px; height: 150px; transform-style: preserve-3d; animation: spin 18s linear infinite; }
  .face { position: absolute; inset: 0; border: 4px solid var(--color-brand-green); border-radius: 16px; background: rgba(8,128,224,.04); }
  .face:nth-child(1) { transform: translateZ(75px); }
  .face:nth-child(2) { transform: rotateY(90deg) translateZ(75px); border-color: var(--color-brand-blue); }
  .face:nth-child(3) { transform: rotateY(180deg) translateZ(75px); }
  .face:nth-child(4) { transform: rotateY(-90deg) translateZ(75px); border-color: var(--color-brand-blue); }
  /* Outside the rotating .cube, so it always reads "MH" forwards. */
  .mark { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center;
          font: 800 42px/1 system-ui, sans-serif; color: var(--color-brand-blue); pointer-events: none; }
  @keyframes spin { from { transform: rotateX(-16deg) rotateY(0); } to { transform: rotateX(-16deg) rotateY(360deg); } }
  @media (prefers-reduced-motion: reduce) { .cube { animation: none; } }
</style>
